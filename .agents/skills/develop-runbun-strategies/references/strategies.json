  "strategies": [
    {
      "id": "setup-window-sweep",
      "title": "Create a bounded setup window, then sweep",
      "status": "retired",
      "superseded_by": ["fresh-entry-fake-out-tempo", "trainer-profile:gavi"],
      "tags": [
        "setup",
        "sweep",
        "single-battle"
      ],
      "intent": "Use immunity, resistance, forced low damage, or deterministic status control to gain boosts before defeating multiple reserves.",
      "scope": {
        "format": "single",
        "claim": "candidate pattern only"
      },
      "requirements": [
        "complete enemy roster and send-out order",
        "setup user survives every modeled reply during setup",
        "post-setup speed and damage bounds cover every remaining reserve",
        "PP and accuracy remain sufficient for the full line"
      ],
      "line": [
        "enter only on a verified setup window",
        "boost only to the minimum required stage",
        "sweep in the precomputed move order",
        "stop immediately when an abort rule becomes true"
      ],
      "blockers": [
        "critical-hit exposure that can cause catastrophic loss",
        "phazing, Haze, Encore, Taunt, priority KO, status lock, forced switch, or setup denial",
        "unknown reserve, item, ability, move effect, or AI branch"
      ],
      "abort_rules": [
        "actual HP or stat stage differs from prediction",
        "opponent reveals an unmodeled move, item, ability, or reserve",
        "fresh certificate no longer selects the planned action"
      ],
      "executable": {
        "when": {
          "active_role": "croakatoa",
          "opponent_species": [
            603
          ],
          "fresh_entry": true
        },
        "directives": [
